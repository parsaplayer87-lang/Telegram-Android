// Liquid glass refraction + chromatic dispersion ported from Kyant0/AndroidLiquidGlass
// (backdrop 1.0.6, RoundedRectRefractionWithDispersionShaderString). Apache-2.0, Copyright 2025 Kyant.
// Adapted to Telegram's liquid-glass uniform interface (img/center/size/radius/thickness/...).
uniform shader img;

uniform float2 center;
uniform float2 size;          // half-size of the shape, in node pixels
uniform float4 radius;        // (rightBottom, rightTop, leftBottom, leftTop)
uniform float thickness;      // refraction edge band height
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;

float radiusAt(float2 p, float4 r) {
    if (p.x >= 0.0) {
        return (p.y <= 0.0) ? r.y : r.x;   // rightTop : rightBottom
    } else {
        return (p.y <= 0.0) ? r.w : r.z;   // leftTop : leftBottom
    }
}

float sdRoundedRect(float2 coord, float2 halfSize, float r) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(r));
    float outside = length(max(cornerCoord, 0.0)) - r;
    float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
    return outside + inside;
}

float2 gradSdRoundedRect(float2 coord, float2 halfSize, float r) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(r));
    if (cornerCoord.x >= 0.0 || cornerCoord.y >= 0.0) {
        return sign(coord) * normalize(max(cornerCoord, 0.0));
    } else {
        float gradX = step(cornerCoord.y, cornerCoord.x);
        return sign(coord) * float2(gradX, 1.0 - gradX);
    }
}

float circleMap(float x) {
    return 1.0 - sqrt(1.0 - x * x);
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = src.rgb + dst.rgb * (1.0 - src.a);
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
    float2 halfSize = size;
    float2 centeredCoord = fragCoord - center;
    float r = radiusAt(centeredCoord, radius);

    float sd = sdRoundedRect(centeredCoord, halfSize, r);
    float refractionHeight = thickness;
    // flat interior: no refraction past the edge band
    if (-sd >= refractionHeight) {
        return srcOver(half4(foreground_color_premultiplied), img.eval(fragCoord));
    }
    sd = min(sd, 0.0);

    // Kyant0 circular lens profile; amount = 2x band at Telegram's default intensity (0.75),
    // matching the library demo's 12dp height / 24dp amount ratio. Negative pulls samples inward.
    float refractionAmount = -thickness * 2.0 * (refract_intensity / 0.75);
    float depthEffect = clamp(refract_index - 1.0, 0.0, 1.0);
    float chromaticAberration = 1.0;

    float d = circleMap(1.0 - -sd / refractionHeight) * refractionAmount;
    float gradRadius = min(r * 1.5, min(halfSize.x, halfSize.y));
    float2 grad = normalize(gradSdRoundedRect(centeredCoord, halfSize, gradRadius) + depthEffect * normalize(centeredCoord));

    float2 refractedCoord = fragCoord + d * grad;
    // stay within the shape so a small/downsampled glass never samples past the far side
    refractedCoord = clamp(refractedCoord, center - size + 0.5, center + size - 0.5);
    float dispersionIntensity = chromaticAberration * ((centeredCoord.x * centeredCoord.y) / (halfSize.x * halfSize.y));
    float2 dispersedCoord = d * grad * dispersionIntensity;

    half4 color = half4(0.0);

    half4 red = img.eval(refractedCoord + dispersedCoord);
    color.r += red.r / 3.5;
    color.a += red.a / 7.0;

    half4 orange = img.eval(refractedCoord + dispersedCoord * (2.0 / 3.0));
    color.r += orange.r / 3.5;
    color.g += orange.g / 7.0;
    color.a += orange.a / 7.0;

    half4 yellow = img.eval(refractedCoord + dispersedCoord * (1.0 / 3.0));
    color.r += yellow.r / 3.5;
    color.g += yellow.g / 3.5;
    color.a += yellow.a / 7.0;

    half4 green = img.eval(refractedCoord);
    color.g += green.g / 3.5;
    color.a += green.a / 7.0;

    half4 cyan = img.eval(refractedCoord - dispersedCoord * (1.0 / 3.0));
    color.g += cyan.g / 3.5;
    color.b += cyan.b / 3.0;
    color.a += cyan.a / 7.0;

    half4 blue = img.eval(refractedCoord - dispersedCoord * (2.0 / 3.0));
    color.b += blue.b / 3.0;
    color.a += blue.a / 7.0;

    half4 purple = img.eval(refractedCoord - dispersedCoord);
    color.r += purple.r / 7.0;
    color.b += purple.b / 3.0;
    color.a += purple.a / 7.0;

    return srcOver(half4(foreground_color_premultiplied), color);
}